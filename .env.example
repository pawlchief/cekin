# Salin menjadi .env lalu isi. JANGAN commit file .env.
NODE_ENV=development
PORT=3001

# Alamat yang dibuka pengguna di browser. Dipakai untuk membuat tautan di email.
# Dev (Vite): http://localhost:5174   |   Produksi: https://domainmu.com
APP_URL=http://localhost:5174

# MySQL (port 3308)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=cekin
DB_USER=cekin
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Wajib, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# true jika diakses lewat HTTPS (produksi). false untuk http://localhost
COOKIE_SECURE=false
# true jika berjalan di belakang reverse proxy (Caddy/Nginx)
TRUST_PROXY=false

# Email (lupa kata sandi). Kosongkan SMTP_HOST saat pengembangan:
# tautan reset akan dicetak di terminal server, bukan dikirim.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cekin <no-reply@example.com>"
